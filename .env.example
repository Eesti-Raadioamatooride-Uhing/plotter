# Copy to .env (deploy/deploy.sh does it for you). It is read twice: docker
# compose interpolates the host-side settings below, and everything else is
# handed to the app inside the container.

# --- host side (docker compose only)
# Where the containers run and where state lives on the host. deploy.sh
# rewrites the first two to match your user and engine, so you rarely set them
# by hand.
#   PLOTTER_RUN_AS: uid:gid the app runs as inside the container.
#     rootful docker -> your own uid:gid (id -u):(id -g)
#     rootless docker or podman -> 0:0, already mapped to your host user
PLOTTER_RUN_AS=1000:1000
#   PLOTTER_STATE_DIR: host directory holding the elevation cache, the SQLite
#     database and the harvested registers. Left blank, deploy.sh puts it in
#     ~/.local/share/plotter, and a bare "docker compose up" uses ./data.
PLOTTER_STATE_DIR=
PLOTTER_PUBLIC_PORT=8088
#   PLOTTER_DEM_DIR: a host directory of your own DEM tiles, mounted read-only
#     at /dem. Point PLOTTER_LIDAR_EE_DIR / PLOTTER_LIDAR_FI_DIR below at
#     subdirectories of it. Left unset, no local DEM is used and elevation
#     comes from the Copernicus/WCS caches.
#PLOTTER_DEM_DIR=/srv/dem
# The WAF answers only for this name. Cloudflare's origin pull sends it.
PLOTTER_SERVERNAME=plotter.local

# --- server (inside the container)
PLOTTER_HOST=0.0.0.0
PLOTTER_PORT=8000
PLOTTER_WORKERS=4
PLOTTER_LOG_LEVEL=info

# --- storage (inside the container; PLOTTER_STATE_DIR is mounted at /data)
PLOTTER_DATA_DIR=/data
PLOTTER_CACHE_DIR=/data/cache
PLOTTER_DATABASE_URL=sqlite:////data/plotter.sqlite

# --- elevation
# Copernicus GLO-30 (30 m) needs nothing and is the global default.
# Estonian 1 m LiDAR DTM comes from the Maa-amet WCS on demand (cached per
# cell); it is on by default. Set coverage to dtm-10 or dtm-25 for lighter
# tiles, or blank the URL to disable and fall back to Copernicus.
PLOTTER_MAAAMET_WCS_URL=https://teenus.maaamet.ee/ows/wcs-dtm
PLOTTER_MAAAMET_WCS_COVERAGE=dtm-1
# Point these at local LiDAR tiles if you have downloaded them. These are
# paths INSIDE the container: set PLOTTER_DEM_DIR above to the host directory
# and it is mounted read-only at /dem. A .vrt over the tiles works and is the
# fastest option, since it needs no network at all.
#PLOTTER_LIDAR_EE_DIR=/dem/maaamet
#PLOTTER_LIDAR_FI_DIR=/dem/mml
#PLOTTER_MML_API_KEY=

# --- web app hardening
# The registry-refresh and JVIS-discover endpoints mutate state and hit
# external services. Set an admin key to use them from the web (send it in an
# X-Admin-Key header); left blank, they are reachable only from localhost.
#PLOTTER_ADMIN_KEY=change-me-to-a-long-random-string
# Interactive API docs (/docs, /redoc, /openapi.json) are off by default.
#PLOTTER_ENABLE_DOCS=false

# --- registry scraping
PLOTTER_JVIS_ENABLED=true
# The public register is served as an AJAX fragment under this path.
PLOTTER_JVIS_MODULE_PATH=/modules/sideluba/avalik
PLOTTER_JVIS_REQUEST_DELAY_S=2.0
PLOTTER_JVIS_USER_AGENT=Plotter/1.0 (antenna planning; you@example.org)
# jvis.ttja.ee's robots.txt disallows everything but the homepage. Leave this
# true unless you (the operator) have cleared automated access with TTJA.
PLOTTER_JVIS_RESPECT_ROBOTS=true
