[Unit]
Description=Plotter data refresh (masts and frequency register)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=plotter
Group=plotter
WorkingDirectory=/opt/plotter
EnvironmentFile=-/etc/plotter/plotter.env
ExecStart=/opt/plotter/venv/bin/plotter-refresh refresh all --tolerant
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StateDirectory=plotter
ReadWritePaths=/var/lib/plotter
