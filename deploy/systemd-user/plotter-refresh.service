# Nightly data refresh, as a USER unit. Install with:
#   ./deploy/user-timer.sh install
# It runs the refresh inside the app container, so it needs no venv and no
# root. %h is your home directory; the installer rewrites WorkingDirectory
# to wherever this checkout lives.
[Unit]
Description=Plotter data refresh (masts and frequency register)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/plotter
ExecStart=/usr/bin/docker compose run --rm --no-deps app plotter-refresh refresh all --tolerant
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
